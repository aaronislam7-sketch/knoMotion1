{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HeroTextEntranceExit Schema",
  "description": "Schema for HeroTextEntranceExit mid-scene component",
  "type": "object",
  "required": ["heroType", "heroRef", "beats"],
  "properties": {
    "text": {
      "type": "string",
      "description": "Text content to display"
    },
    "heroType": {
      "type": "string",
      "enum": ["image", "lottie", "svg", "roughSVG", "emoji", "custom"],
      "default": "image",
      "description": "Type of hero visual (resolved via the hero registry)"
    },
    "heroRef": {
      "type": "string",
      "description": "Path, URL, lottie registry key, or emoji depending on heroType"
    },
    "animationEntrance": {
      "type": "string",
      "enum": ["fadeIn", "slideIn", "scaleIn", "fadeSlide"],
      "default": "fadeIn",
      "description": "Entrance animation type"
    },
    "animationExit": {
      "type": "string",
      "enum": ["fadeOut", "slideOut", "scaleOut"],
      "default": "fadeOut",
      "description": "Exit animation type"
    },
    "beats": {
      "type": "object",
      "description": "Timing in seconds. Requires exit and one of entrance/start (start is accepted as an alias for entrance).",
      "required": ["exit"],
      "anyOf": [
        { "required": ["entrance"] },
        { "required": ["start"] }
      ],
      "properties": {
        "entrance": {
          "type": "number",
          "description": "Entrance beat in seconds"
        },
        "start": {
          "type": "number",
          "description": "Alias for entrance (used if entrance is omitted)"
        },
        "exit": {
          "type": "number",
          "description": "Exit beat in seconds"
        }
      }
    },
    "position": {
      "type": "object",
      "description": "Optional position override (uses layout engine)",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "style": {
      "type": "object",
      "description": "Optional style overrides",
      "properties": {
        "container": { "type": "object" },
        "heroContainer": { "type": "object" },
        "hero": { "type": "object" },
        "text": { "type": "object" }
      }
    }
  }
}
